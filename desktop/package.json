{
  "name": "ielts-pass-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop client for IELTS Pass",
  "main": "main.cjs",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "^37.2.6", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "com.shuhuihuang.ieltspass",
    "productName": "IELTS Pass",
    "directories": { "output": "release" },
    "files": ["main.cjs", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "IELTS-Pass-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "IELTS-Pass-Portable-${version}-${arch}.${ext}" }
  }
}
