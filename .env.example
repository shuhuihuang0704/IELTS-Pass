# Configure these values through the hosting platform before enabling WeChat login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Email verification login through Brevo. Keep these server-side only.
BREVO_API_KEY=
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=IELTS PASS
# Generate at least 32 random characters; changing it invalidates outstanding codes.
AUTH_OTP_SECRET=
